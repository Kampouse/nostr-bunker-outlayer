package near:rpc@0.1.0;

interface api {
    // Query methods (view functions)
    view: func(contract-id: string, method-name: string, args-json: string, finality: string) -> tuple<result: string, error: string>;
    view-account: func(account-id: string, finality: string) -> tuple<result: string, error: string>;
    view-access-key: func(account-id: string, public-key: string, finality: string) -> tuple<result: string, error: string>;
    view-access-key-list: func(account-id: string, finality: string) -> tuple<result: string, error: string>;
    view-code: func(account-id: string, finality: string) -> tuple<result: string, error: string>;
    view-state: func(account-id: string, prefix: string, finality: string) -> tuple<result: string, error: string>;
    
    // Transaction methods
    call: func(signer-id: string, signer-key: string, receiver-id: string, method-name: string, args-json: string, deposit: string, gas: string, wait-until: string) -> tuple<tx-hash: string, error: string>;
    transfer: func(signer-id: string, signer-key: string, receiver-id: string, amount: string, wait-until: string) -> tuple<tx-hash: string, error: string>;
    
    // Transaction status
    tx-status: func(tx-hash: string, sender-id: string, wait-until: string) -> tuple<result: string, error: string>;
    receipt: func(receipt-id: string) -> tuple<result: string, error: string>;
    
    // Block methods
    block: func(finality: string) -> tuple<result: string, error: string>;
    chunk: func(chunk-id: string) -> tuple<result: string, error: string>;
    changes: func(finality: string) -> tuple<result: string, error: string>;
    
    // Network methods
    gas-price: func(block-id: string) -> tuple<result: string, error: string>;
    status: func() -> tuple<result: string, error: string>;
    network-info: func() -> tuple<result: string, error: string>;
    validators: func(epoch-id: string) -> tuple<result: string, error: string>;
    
    // Low-level API
    raw: func(method: string, params-json: string) -> tuple<result: string, error: string>;
}

world outlayer-host {
    import api;
    
    export env: {
        input: func() -> string;
        output: func(output: string);
        var: func(key: string) -> option<string>;
        signer-account-id: func() -> option<string>;
    };
    
    export storage: {
        get: func(key: string) -> option<string>;
        set: func(key: string, value: string);
        delete: func(key: string);
        increment: func(key: string, delta: u64) -> u64;
    };
}
